{
  "expo": {
    "name": "TradiLibras",
    "slug": "tradilibras",
    "scheme": "tradilibras",
    "version": "1.0.0",
    "android": {
      "package": "com.tradilibras.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/logoapp.jpg",
        "backgroundColor": "#8bc1ff"
      }
    },
    "extra": {
      "eas": {
        "projectId": "1d04bd1c-34d3-4c05-8d33-e322e4dded6f"
      }
    },
    "plugins": [
      "expo-font",
      "expo-router",
      "expo-web-browser",
      "expo-video",
      "expo-image",
      "expo-splash-screen",
      "expo-status-bar",
      "expo-asset",
      [
        "react-native-vision-camera",
        {
          "cameraPermissionText": "Precisamos da câmera para traduzir Libras."
        }
      ],
      [
        "expo-vision-camera-v4-mediapipe/plugin/index.js",
        {
          "numHands": 1,
          "minDetectionConfidence": 0.5,
          "minPresenceConfidence": 0.5,
          "minTrackingConfidence": 0.5
        }
      ]
    ]
  }
}
